{
  "name": "sr-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:test": "cross-env SKIP_ENV_VALIDATION=true next dev --turbopack",
    "build": "next build && pnpm check:standalone-secrets",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .eslintcache --max-warnings 790",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier . --check --cache",
    "format:fix": "prettier . --write",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "analyze": "cross-env ANALYZE=true next build",
    "type-check": "tsc --noEmit",
    "verify:static": "concurrently --kill-others-on-fail --group -c \"cyan,green,magenta\" -n \"TSC,LINT,FORMAT\" \"pnpm type-check\" \"pnpm lint\" \"pnpm format:check\"",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:ci": "tsx scripts/stryker-ci.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:multi-user": "playwright test --project=multi-user",
    "test:e2e:setup": "playwright test --project=multi-user-setup",
    "report:slow-queries": "tsx scripts/summarize-slow-queries.ts",
    "warm:dashboard": "tsx scripts/warm-dashboard.ts",
    "cleanup:system-team-clients": "tsx scripts/cleanup-system-team-clients.ts",
    "cleanup:system-team-clients:dry-run": "tsx scripts/cleanup-system-team-clients.ts --dry-run",
    "prepare": "husky",
    "verify": "powershell -ExecutionPolicy Bypass -File ./scripts/run-verification.ps1",
    "verify:fast": "powershell -ExecutionPolicy Bypass -File ./scripts/run-verification.ps1 -fast",
    "check:e2e-assertions": "tsx scripts/check-e2e-assertions.ts",
    "check:standalone-secrets": "tsx scripts/check-standalone-secrets.ts",
    "check:dead": "knip --max-issues 4",
    "test:integration": "vitest run --project=integration"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@vercel/functions": "^3.9.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "file-type": "^21.3.4",
    "lucide-react": "^0.575.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.2",
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "knip": "^6.32.2",
    "lint-staged": "^16.2.7",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "prettier": "3.9.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^3.1.0"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --cache --cache-location .eslintcache",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "bn.js@<4.12.3": "4.12.5",
      "defu@<=6.1.4": "6.1.7",
      "effect@<3.20.0": "3.22.1",
      "fast-xml-parser@>=5.0.0 <5.3.5": ">=5.3.5"
    }
  },
  "packageManager": "pnpm@10.14.0"
}
