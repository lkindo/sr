# ==============================================================================
# SR MANAGEMENT SYSTEM - OPTIMIZED GITIGNORE
# ==============================================================================

# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.pnpm-store/
.pnpm-debug.log*

# 2. Next.js, Vercel & Turbo Build Outputs
# ------------------------------------------------------------------------------
/.next/
/.next-e2e/
/out/
/build/
/dist/
.turbo/
.vercel/

# 3. Environment Variables & Credentials (CRITICAL SECRETS)
# ------------------------------------------------------------------------------
.env
.env*.local
# `.env` 를 잠깐 다른 DB 로 돌려 놓고 원본을 옆에 백업해 두는 일이 실제로 있었다.
# `.env.e2ebackup` 같은 이름은 위의 두 줄에 걸리지 않아 `git add -A` 한 번이면
# 시크릿째 커밋된다 — 이 저장소가 이미 한 번 당한 사고다(감사 3.1: 루트 커밋의
# `.env.docker` 가 아직도 NEXTAUTH_SECRET 을 노출한다). 접두사로 통째로 막는다.
.env.*
!.env.example
# Docker 배포용 실제 시크릿(NEXTAUTH_SECRET/AUTH_SECRET, DB 비밀번호) 추적 차단.
# 플레이스홀더만 담은 .env.example 은 계속 추적한다.
.env.docker*
/prisma/.env
*.pem
*.key
project.tar.gz

# 4. Prisma Generated Files
# ------------------------------------------------------------------------------
/src/generated

# 5. Playwright & Testing Frameworks
# ------------------------------------------------------------------------------
/playwright-report/
/playwright/.cache/
/coverage/
/test-results/
.stryker-tmp/

# Playwright 인증 정보 세션 (민감 데이터 누출 차단)
playwright/.auth/

# 6. Temporary Logs & Test Results (Generalized wildcard patterns)
# ------------------------------------------------------------------------------
*.log
*.log*
*_debug.log
*_output.txt
*_verbose.txt
*results.txt
*result.json
coverage_summary.txt
coverage_summary_utf8.txt
build_error.log
eslint_results.txt
eslint_output.txt
eslintcache
.eslintcache

# 7. Local Media Uploads
# ------------------------------------------------------------------------------
public/uploads/*
!public/uploads/.gitkeep
# 첨부파일 로컬 저장소 (웹루트 밖, 런타임 데이터)
/var/uploads/

# 8. OS & Common Editor Settings (Includes MS Office Lock files)
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
nul

# MS Office (Word, Excel, PowerPoint) 임시/락 파일 차단 (시스템 매뉴얼 파워포인트 편집용)
~$*
~$*.docx
~$*.xlsx
~$*.pptx

# IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# 9. Other Temporary & Generated Assets
# ------------------------------------------------------------------------------
actions_runs.json
output.css
*.tsbuildinfo
next-env.d.ts

# 빌드 시 esbuild 가 생성하는 기준 데이터 시드 번들(Dockerfile).
# 소스는 prisma/seed.ts 이며 산출물은 커밋하지 않는다.
prisma/seed.bundle.cjs

# 커밋 메시지·리포트 등 작업 중 만드는 임시 파일.
# `git add -A` 에 딸려 들어가 커밋된 적이 있어 패턴으로 막는다.
*.tmp
*.tmp.mjs
*.tmp.json
*.tmp.sh
*.tmp.log

# 편집기·도구가 남기는 사본. `.original.*` 은 실행되지 않는 테스트 백업이
# `__tests__` 안에 660줄로 남아 있던 전례가 있어 패턴으로 막는다.
*.bak
*.orig
*.original.*

# e2e/19-file-upload-download.spec.ts:41-78 이 실행 시점에 직접 만든다.
# 과거에 11MB 짜리 test-large-file.bin 이 커밋되어 있었다.
playwright/.test-files/

# `.Jules/` 와 대소문자만 다른 중복 경로. core.ignorecase 때문에
# 두 철자가 인덱스에 공존해 Linux CI 에서 트리가 갈라졌다.
.jules/
.Jules/
