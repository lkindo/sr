# Database
DATABASE_URL="postgresql://user:password@hostname:port/dbname"
DIRECT_URL="postgresql://user:password@hostname:port/dbname"

# NextAuth
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 환경(운영/스테이징/로컬)마다 서로 다른 값을 발급한다. 같은 값을 쓰면 스테이징에서
# 발급된 세션 쿠키가 운영에서도 유효해진다. 회전 절차는 docs/SECRET_ROTATION.md 참고.
NEXTAUTH_SECRET="change_me_to_random_secret_string"
# Auth.js v5 는 AUTH_SECRET 을 읽는다. 같은 환경 안에서는 NEXTAUTH_SECRET 과 동일 값.
AUTH_SECRET="change_me_to_random_secret_string"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Docker Compose 보간용 (docker-compose.yml / docker-compose.prod.yml)
# ------------------------------------------------------------------------------
# compose 는 프로젝트 디렉터리의 `.env` 파일에서만 이 값들을 보간한다.
# (`env_file: .env.docker` 는 컨테이너 환경변수일 뿐 보간에는 쓰이지 않는다.)
# docker-compose.prod.yml 은 기본값이 없어 값이 비면 `docker compose up` 이 즉시 실패한다.
# 비밀번호는 DATABASE_URL 에 그대로 들어가므로 base64 대신 hex 를 권장한다
# (base64 의 `/` `+` `=` 는 URL 퍼센트 인코딩이 필요하다).
# 생성: openssl rand -hex 24
POSTGRES_USER="change_me_db_user"
POSTGRES_PASSWORD="change_me_generate_with_openssl_rand_hex_24"
# DB 이름은 비밀이 아니며 기존 볼륨과 맞춰야 한다(미지정 시 sr_db).
POSTGRES_DB="sr_db"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_change_me"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token_here"

# Rate Limiting (선택사항 - 기본값 사용 시 생략 가능)
# STRICT: 로그인, 회원가입 등 민감한 작업 (기본: 1분당 5회)
RATE_LIMIT_STRICT_WINDOW_MS="60000"
RATE_LIMIT_STRICT_MAX_REQUESTS="5"

# STANDARD: 일반 API (기본: 1분당 100회)
RATE_LIMIT_STANDARD_WINDOW_MS="60000"
RATE_LIMIT_STANDARD_MAX_REQUESTS="100"

# RELAXED: 읽기 전용 API (기본: 1분당 300회)
RATE_LIMIT_RELAXED_WINDOW_MS="60000"
RATE_LIMIT_RELAXED_MAX_REQUESTS="300"

# FILE_UPLOAD: 파일 업로드 (기본: 1시간당 20회)
RATE_LIMIT_FILE_UPLOAD_WINDOW_MS="3600000"
RATE_LIMIT_FILE_UPLOAD_MAX_REQUESTS="20"

# MIDDLEWARE: 1분당 20회
RATE_LIMIT_MIDDLEWARE_WINDOW_MS="60000"
RATE_LIMIT_MIDDLEWARE_MAX_REQUESTS="20"

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:admin@example.com"


# Email (Gmail SMTP)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="admin@example.com"
EMAIL_SERVER_PASSWORD="your_app_password_here"
EMAIL_FROM="SR System <no-reply@sr-system.com>"


# ─────────────────────────────────────────────────────────────────────────────
# 부트스트랩 (신규 인스턴스 최초 1회)
# ─────────────────────────────────────────────────────────────────────────────
# 깨끗한 DB 로 배포하면 역할·권한은 entrypoint 가 자동 시딩하지만, 관리자 계정은 없다.
# 아래 두 값을 설정하면 최초 부팅 시 ADMIN 을 1명 생성한다.
#
# - ADMIN 이 이미 하나라도 있으면 아무것도 하지 않는다(멱등).
# - 같은 이메일의 기존 사용자가 있으면 비밀번호를 덮어쓰지 않고 역할만 부여한다.
# - 12자 미만 비밀번호는 거부한다.
#
# ⚠️ 로그인해서 비밀번호를 바꾼 뒤에는 이 두 값을 환경에서 제거할 것.
# BOOTSTRAP_ADMIN_EMAIL="admin@your-domain.com"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-to-a-long-random-value"
# BOOTSTRAP_ADMIN_NAME="시스템 관리자"
