yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
test_results.txt
test-results
playwright-report
blob-report
coverage

# 로컬에서 생기는 생성물. `.gitignore` 만 막고 있으면 `COPY . .` 로
# 빌더 레이어에 그대로 구워진다(과거 4MB).
*.tar.gz
*.tsbuildinfo
coverage_summary*.txt
actions_runs.json
build_error.log
output.css

