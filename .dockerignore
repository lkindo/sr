# Dependencies
node_modules
.pnpm-store

# Next.js build output
.next
out
build

# Environment variables (Secrets)
.env
.env.local
.env.production
.env.test
.env*.local
# Docker deployment secrets: `COPY . .` in the builder stage would otherwise bake
# these into an intermediate layer that is exported to the GHA build cache.
.env.docker*

# Private keys and certificates (never needed at build time)
*.key
*.pem

# Legacy attachment directory. Next serves everything under public/ from the URL
# root, so anything left here is downloadable without passing ensureCanReadSR —
# and the middleware matcher skips image extensions entirely, so image
# attachments would not even need a session. Attachments live in STORAGE_DIR
# (a named volume, outside the web root); this directory must never be baked
# into an image again.
public/uploads

# Version control
.git
.gitignore

# IDE and Editor files
.vscode
.idea
*.swp
*.swo

